# RaoGuard local env. Never commit real keys.

APP_ENV=local
PROMPT_VERSION=2026-09-19.1

# Supabase (Free). Service role is backend-only.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Groq. Limits are org-specific: https://console.groq.com/settings/limits
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_FALLBACK=llama-3.1-8b-instant
GROQ_ENABLED=true

# Defaults
DEFAULT_CLIENT_RATE=165
DEFAULT_INTERNAL_RATE=80
DEFAULT_CURRENCY=USD
